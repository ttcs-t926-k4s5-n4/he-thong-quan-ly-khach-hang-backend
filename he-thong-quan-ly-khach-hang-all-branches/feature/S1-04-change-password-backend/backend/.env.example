SECRET_KEY=replace-with-a-long-random-value

# React development URL. Multiple origins are separated by commas.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SQL Server
SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=crm_db
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=YourStrongPassword123!
SQL_SERVER_ENCRYPT=yes
SQL_SERVER_TRUST_CERTIFICATE=yes
SQL_SERVER_TRUSTED_CONNECTION=false

# Login session
LOGIN_SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false

# Local development
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000

# Optional demo account used by scripts/create_demo_user.py
DEMO_USER_EMAIL=demo@company.local
DEMO_USER_PASSWORD=Demo@123456

SECRET_KEY=replace-with-a-long-random-value

# React
FRONTEND_BASE_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# SQL Server
SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=crm_db
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=YourStrongPassword123!
SQL_SERVER_ENCRYPT=yes
SQL_SERVER_TRUST_CERTIFICATE=yes
SQL_SERVER_TRUSTED_CONNECTION=false

# Activation link validity
ACTIVATION_TOKEN_TTL_SECONDS=86400

# Email
# Dùng smtp để gửi email thật. Dùng console để chỉ in nội dung email ra terminal.
MAIL_BACKEND=console
MAIL_FROM=CRM System <no-reply@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=true

FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000
